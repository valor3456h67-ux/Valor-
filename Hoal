-- ═══════════════════════════════════════
-- AIMBOT SUAVE + AUTO SHOT
-- ═══════════════════════════════════════
if not State.aimConn then
    State.aimConn = RunService.RenderStepped:Connect(function(dt)
        if State.aimbotEnabled then
            local target = getClosestAnimalHead()
            if target then
                local myPos = Camera.CFrame.Position
                local aimCF = CFrame.new(myPos, target.Position)
                Camera.CFrame = Camera.CFrame:Lerp(aimCF, State.aimbotSmooth)
            end
        end

        if State.autoShotEnabled then
            local target = getClosestAnimalHead()
            if target then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)

                local char = LocalPlayer.Character
                if char then
                    local tool = char:FindFirstChildWhichIsA("Tool")
                    if tool then
                        if not tool.Enabled then tool.Enabled = true end
                        tool:Activate()
                    end
                end

                pcall(function()
                    local VirtualUser = game:GetService("VirtualUser")
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton1(Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2))
                end)
            end
        end
    end)
end

