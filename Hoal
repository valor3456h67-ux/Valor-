-- FOV: aplicar y forzar
-- ═══════════════════════════════════════
local function applyFOV()
    local newFOV = State.baseFOV * (1 + State.fovPercent / 100)
    Camera.FieldOfView = newFOV
    return newFOV
end

if not State.fovConn then
    State.fovConn = RunService.RenderStepped:Connect(function()
        if State.fovOverride then
            local targetFOV = State.baseFOV * (1 + State.fovPercent / 100)
            if math.abs(Camera.FieldOfView - targetFOV) > 0.1 then
                Camera.FieldOfView = targetFOV
            end
        end
    end)
end

