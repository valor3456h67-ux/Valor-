-- ANIMALES (Zoo or Oof 2 y otros)
-- ═══════════════════════════════════════
local ANIMAL_NAMES = {
    "Animal", "Dog", "Cat", "Lion", "Tiger", "Bear", "Wolf", "Fox",
    "Elephant", "Giraffe", "Zebra", "Monkey", "Rabbit", "Deer", "Horse",
    "Cow", "Pig", "Sheep", "Chicken", "Duck", "Penguin", "Panda",
    "Eagle", "Hawk", "Owl", "Snake", "Crocodile", "Shark", "Whale",
    "Frog", "Turtle", "Dragon", "Dino", "Raptor", "T-Rex", "Pet"
}

local function isAnimal(instance)
    if not instance then return false end
    local name = instance.Name
    for _, animalName in ipairs(ANIMAL_NAMES) do
        if string.find(string.lower(name), string.lower(animalName)) then
            return true
        end
    end
    return false
end

local function getClosestAnimalHead()
    local closest = nil
    local shortest = math.huge
    local myPos = Camera.CFrame.Position

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if isAnimal(player.Character.Name) or isAnimal(player.Name) then
                local head = player.Character:FindFirstChild("Head")
                if head then
                    local dist = (head.Position - myPos).Magnitude
                    if dist < shortest then
                        shortest = dist
                        closest = head
                    end
                end
            end
        end
    end

    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and isAnimal(obj) then
            local head = obj:FindFirstChild("Head")
                         or obj:FindFirstChild("head")
                         or obj:FindFirstChildWhichIsA("BasePart")
            if head and head:IsA("BasePart") then
                local dist = (head.Position - myPos).Magnitude
                if dist < shortest then
                    shortest = dist
                    closest = head
                end
            end
        end
    end

    return closest
end

-- ═══════════════════════════════════════
-- SHADERS ROSADOS
-- ═══════════════════════════════════════
local function enablePinkShaders()
    for _, v in pairs(Lighting:GetChildren()) do
        if v.Name:sub(1, 12) == "PinkShader__" then v:Destroy() end
    end

    local cc = Instance.new("ColorCorrectionEffect")
    cc.Name = "PinkShader__ColorCorrection"
    cc.Brightness = 0.05
    cc.Contrast = 0.15
    cc.Saturation = 0.35
    cc.TintColor = Color3.fromRGB(255, 180, 220)
    cc.Parent = Lighting

    local bloom = Instance.new("BloomEffect")
    bloom.Name = "PinkShader__Bloom"
    bloom.Intensity = 0.8
    bloom.Size = 24
    bloom.Threshold = 0.9
    bloom.Parent = Lighting

    local atmo = Instance.new("Atmosphere")
    atmo.Name = "PinkShader__Atmosphere"
    atmo.Density = 0.35
    atmo.Offset = 0.1
    atmo.Color = Color3.fromRGB(255, 200, 230)
    atmo.Decay = Color3.fromRGB(255, 150, 200)
    atmo.Glare = 0.2
    atmo.Haze = 1.5
    atmo.Parent = Lighting

    local sr = Instance.new("SunRaysEffect")
    sr.Name = "PinkShader__SunRays"
    sr.Intensity = 0.15
    sr.Spread = 0.8
    sr.Parent = Lighting
end

local function disablePinkShaders()
    for _, v in pairs(Lighting:GetChildren()) do
        if v.Name:sub(1, 12) == "PinkShader__" then v:Destroy() end
    end
end

